# Configurações do WordStream PWA
NODE_ENV=production
PORT=3500

# Redis Configuration
REDIS_URL=redis://192.168.5.210:6379

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://contador.bdjcoins.com
NEXT_PUBLIC_BASE_URL=http://contador.bdjcoins.com
NEXT_PUBLIC_APP_NAME=WordStream

# PWA Configuration
NEXT_PUBLIC_PWA_NAME=WordStream
NEXT_PUBLIC_PWA_SHORT_NAME=WordStream
NEXT_PUBLIC_PWA_DESCRIPTION=Aplicativo de streaming de palavras em tempo real
NEXT_PUBLIC_PWA_THEME_COLOR=#000000
NEXT_PUBLIC_PWA_BACKGROUND_COLOR=#ffffff

# Twitch Configuration (se aplicável)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://contador.bdjcoins.com/auth/twitch/callback

# WebSocket Configuration
WS_PORT=3001
WS_HOST=localhost

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# PM2 Configuration
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY_RESTART=1G

# Security
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Database (se necessário no futuro)
DATABASE_URL=postgresql://user:password@localhost:5432/wordstream

# Email Configuration (se necessário no futuro)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Analytics (se necessário no futuro)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Monitoring
SENTRY_DSN=your-sentry-dsn-here
